.retelling {
  --retelling-section-gap: 36rpx;
  --retelling-card-gap: 32rpx;
  --retelling-action-gap: 40rpx;
  display: flex;
  min-height: calc(100vh - 44px - env(safe-area-inset-top));
  flex-direction: column;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.retelling-state {
  box-sizing: border-box;
  width: 100%;
}

.retelling-state--short {
  display: flex;
  min-height: calc(100vh - 44px - env(safe-area-inset-top) - 72rpx - env(safe-area-inset-bottom));
  flex: 1;
  flex-direction: column;
}

.short-state-body {
  display: flex;
  width: 100%;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: var(--retelling-section-gap) 0 calc(var(--retelling-section-gap) + 5vh);
}

.short-state-content {
  box-sizing: border-box;
  width: 100%;
}

.retelling-state--long,
.result-body,
.long-result {
  width: 100%;
}

.material-card,
.evidence-card,
.result-card,
.processing-card {
  margin: var(--retelling-card-gap) 0;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #343432;
  font-size: 28rpx;
  line-height: 1.85;
}

.retelling__instruction,
.retelling__context {
  display: block;
  margin: 28rpx 0;
  color: #777772;
  font-size: 25rpx;
  line-height: 1.65;
}

.retelling__action,
.short-state-action,
.result-actions {
  margin-top: var(--retelling-action-gap);
}

.recording-group .retelling__context {
  margin-bottom: var(--retelling-card-gap);
}

.retelling__recorder {
  display: block;
  width: 100%;
}

.hint-group .evidence-card {
  margin-bottom: 0;
}

.hint-group .short-state-action {
  margin-top: var(--retelling-action-gap);
}

.compact-result {
  padding-top: 8rpx;
}

.evidence-card__label,
.result-card__label {
  display: block;
  margin-bottom: 12rpx;
  color: #8a8a84;
  font-size: 23rpx;
}

.result-card__divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: #e8e8e3;
}

.result-section-title {
  display: block;
  margin-top: 44rpx;
  color: #595955;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.5;
}

.change-card {
  margin-top: 18rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ecece8;
}

.change-card__label {
  display: block;
  color: #85857f;
  font-size: 22rpx;
  line-height: 1.5;
}

.change-card__sequence {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 14rpx;
}

.change-card__item {
  color: #30302e;
  font-size: 28rpx;
  line-height: 1.65;
}

.change-card__arrow,
.change-card__transition {
  color: #92928c;
  font-size: 24rpx;
  line-height: 1.5;
}

.change-card__arrow {
  margin: 4rpx 0;
}

.change-card__transition {
  margin: 24rpx 0;
  text-align: center;
}

.change-summary {
  display: block;
  margin-top: 18rpx;
  color: #666662;
  font-size: 25rpx;
  line-height: 1.65;
}

.result-explanation {
  margin: var(--retelling-card-gap) 0;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ecece8;
  color: #4d4d49;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-structure {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 22rpx;
  color: #30302e;
  line-height: 1.55;
}

.expression-reference {
  display: block;
  margin-top: 18rpx;
  color: #30302e;
}

.retelling__finish {
  display: block;
  width: 100%;
  margin-top: 18rpx;
  text-align: center;
}

.retelling__switch {
  display: block;
  min-width: 160rpx;
  min-height: 72rpx;
  margin: 18rpx auto 0;
  padding: 12rpx 24rpx;
  color: #85857f;
  font-size: 25rpx;
  line-height: 48rpx;
  text-align: center;
}

.retelling__switch::after {
  border: none;
}

.processing-card {
  margin: 0;
  text-align: center;
}

.processing-dot {
  width: 20rpx;
  height: 20rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background: #333;
}
