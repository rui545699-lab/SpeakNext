.result-card {
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  border: 2rpx solid #e0e0db;
  border-radius: 28rpx;
  background: #fff;
}

.result-card__title,
.result-card__label,
.result-card__word,
.result-card__specific,
.result-card__insight {
  display: block;
}

.result-card__title {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.45;
}

.result-card__label {
  margin-top: 38rpx;
  color: #858580;
  font-size: 24rpx;
}

.result-card__quote {
  margin-top: 14rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #f0f0ed;
  color: #40403d;
  font-size: 29rpx;
  line-height: 1.65;
}

.result-card__change {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 30rpx;
  gap: 12rpx;
}

.result-card__change-text {
  color: #363633;
  font-size: 30rpx;
  line-height: 1.55;
}

.result-card__arrow {
  color: #999994;
  font-size: 28rpx;
  line-height: 1;
}

.result-card__specific {
  margin-top: 32rpx;
  color: #464643;
  font-size: 30rpx;
  line-height: 1.65;
}

.result-card__word {
  margin-top: 32rpx;
  color: #292929;
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.4;
}

.result-card__insight {
  margin-top: 30rpx;
  color: #565652;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.65;
}
