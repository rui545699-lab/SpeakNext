:host {
  display: block;
  width: 100%;
}

.primary {
  display: flex;
  width: 100%;
  height: 100rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 28rpx;
  background: #191919;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: normal;
  text-align: center;
}

.primary__text {
  margin: 0;
  padding: 0;
  line-height: 1;
}

.primary::after {
  border: none;
}

.primary--disabled {
  background: #bdbdb8;
  color: #f4f4f2;
}
