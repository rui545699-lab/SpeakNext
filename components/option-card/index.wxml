<button class="option {{selected ? 'option--selected' : ''}}" hover-class="option--pressed" hover-start-time="0" hover-stay-time="0" bindtap="handleTap">
  <view class="option__heading">
    <text class="option__title">{{title}}</text>
  </view>
  <text wx:if="{{description}}" class="option__description">{{description}}</text>
</button>
