.question-card {
  box-sizing: border-box;
  padding: 32rpx;
  border: 2rpx solid #e1e1dc;
  border-radius: 28rpx;
  background: #fff;
}

.question-card__label {
  display: block;
  color: #858580;
  font-size: 24rpx;
}

.question-card__text {
  display: block;
  min-height: 142rpx;
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: 550;
  line-height: 1.6;
}

.question-card__change {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: #60605c;
  font-size: 28rpx;
  line-height: 64rpx;
}
